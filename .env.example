# ═══════════════════════════════════════════════════════
# LLM Wiki Demo — 环境变量配置
# 复制为 .env 后编辑填入真实值
# ═══════════════════════════════════════════════════════

# ── LLM API ──
# QWEN_API_KEY 仅作为个人 BYOK，不作为系统默认
QWEN_API_KEY=<configure-locally>
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_ID=deepseek-v4-pro

# ── 公司部署模型（系统默认，内网可用）──
GLM_API_KEY=<configure-locally>
GLM_BASE_URL=http://10.180.1.202:30000/v1
GLM_MODEL_ID=/models/GLM-5.2-W4A8
DSV4PRO_API_KEY=<configure-locally>
DSV4PRO_BASE_URL=http://10.180.1.206:30000/v1
DSV4PRO_MODEL_ID=/models/DeepSeek-V4-Pro-W4A8

# ── 可选：阿里云 IQS 搜索 API ──
ALIYUN_API_KEY=<configure-locally>

# ── MinIO 对象存储 ──
USE_MINIO=true
MINIO_ENDPOINT=113.249.91.68:9000
MINIO_ACCESS_KEY=<configure-locally>
MINIO_SECRET_KEY=<configure-locally>
MINIO_BUCKET=wiki-test

# ── JWT 密钥（留空则首次启动自动生成）──
JWT_SECRET=<configure-locally>

# ── 注册白名单（逗号分隔，留空则不限制注册）──
ALLOWED_USERS=admin

# ── Schema 领域自适应（可插拔，false=关闭，true=开启）──
ENABLE_SCHEMA=true
# ── 全局模型提供商（改这一行切换所有调用点，可选: qwen(阿里云百炼） / dsv4pro（公司） / glm（公司））──
DEFAULT_PROVIDER=qwen

