# ═══════════════════════════════════════════════════════
# LLM Wiki Demo — 环境变量配置
# 复制为 .env 后编辑填入真实值
# ═══════════════════════════════════════════════════════

# ── LLM API ──
# QWEN_API_KEY 仅作为个人 BYOK，不作为系统默认
QWEN_API_KEY=<configure-locally>
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_ID=deepseek-v4-pro

# ── 私有化部署模型（请按实际环境配置）──
GLM_API_KEY=<configure-locally>
GLM_BASE_URL=http://your-internal-llm-service:30000/v1
GLM_MODEL_ID=/your/model/path
DSV4PRO_API_KEY=<configure-locally>
DSV4PRO_BASE_URL=http://your-internal-llm-service:30000/v1
DSV4PRO_MODEL_ID=/your/model/path

# ── 可选：阿里云 IQS 搜索 API ──
ALIYUN_API_KEY=<configure-locally>

# ── MinIO 对象存储 ──
USE_MINIO=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=your_bucket

# ── JWT 密钥（留空则首次启动自动生成）──
JWT_SECRET=<configure-locally>

# ── 注册白名单（逗号分隔，留空则不限制注册）──
ALLOWED_USERS=admin

# ── Schema 领域自适应（可插拔，false=关闭，true=开启）──
ENABLE_SCHEMA=true
# ── 全局模型提供商（改这一行切换所有调用点，可选: qwen / dsv4pro / glm）──
DEFAULT_PROVIDER=qwen
